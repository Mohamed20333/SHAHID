# Shahid local configuration
NODE_ENV=development
PORT=3000
SHAHID_DB_PATH=./data/shahid.db

# Required in production. Use a long random value (at least 32 bytes).
SHAHID_JWT_SECRET=replace-with-a-long-random-secret

# Docker Compose / PostgreSQL
POSTGRES_DB=shahid
POSTGRES_USER=shahid
POSTGRES_PASSWORD=change-me