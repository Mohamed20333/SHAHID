# SHAHID local configuration
NODE_ENV=development
PORT=3000
SHAHID_DB_PATH=./data/shahid.db

# Production: generate with a cryptographically secure random generator.
# Never commit the real value.
SHAHID_JWT_SECRET=replace-with-at-least-32-random-bytes

# Browser/API origins. Comma-separated exact origins; never use "*".
SHAHID_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL development database
POSTGRES_DB=shahid
POSTGRES_USER=shahid
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Production API
PORT=8080
DATABASE_URL=postgresql://shahid:change-me@localhost:5432/shahid
REDIS_URL=redis://localhost:6379
SHAHID_ALLOWED_ORIGINS=http://localhost:8081
